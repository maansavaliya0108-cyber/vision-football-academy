# Port the whole site runs on in production (npm start)
PORT=8787

# Public address of the site in production, used for share links, robots.txt and the sitemap
# SITE_URL=https://visionfootballacademy.in

# Port for the API during development (npm run dev); Vite proxies /api to it
API_PORT=4387

# Password for the enquiries dashboard at /admin (8 or more characters; the example value is refused).
# Leave it empty to turn the dashboard off.
ADMIN_PASSWORD=change-me

# Long random string that signs admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: where the SQLite database lives (default: data/academy.db)
# DATABASE_PATH=data/academy.db

# Optional: a Slack/Discord/Make/Zapier webhook to ping for every new enquiry
# ENQUIRY_WEBHOOK_URL=

# Set when running behind a reverse proxy (e.g. 1 for a single proxy hop)
# TRUST_PROXY=1
