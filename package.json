{
  "name": "vision-football-academy",
  "version": "1.0.0",
  "private": true,
  "description": "Website and enquiry system for Vision Football Academy, Adajan, Surat",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:servers": "concurrently -k -n api,web -c yellow,cyan \"node --watch --env-file-if-exists=.env server/index.js\" \"vite\"",
    "dev:follow": "node scripts/dev-follow.mjs",
    "build": "vite build",
    "build:pages": "VITE_STATIC=true VITE_BASE=/vision-football-academy/ SITE_URL=https://maansavaliya0108-cyber.github.io/vision-football-academy vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "preview": "npm run build && npm start",
    "dev:stop": "node scripts/dev-stop.mjs",
    "images": "node scripts/make-images.mjs",
    "og": "node scripts/capture-og.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "lenis": "^1.3.27",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "puppeteer-core": "^25.16.0",
    "vite": "^8.3.5"
  }
}
